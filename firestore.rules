rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bilalit.rfc@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.id == userId &&
        request.resource.data.role == 'customer';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Products (Menu items)
    match /products/{productId} {
      allow read: if true; // Public menu reading
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true; // Public category listing
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          (resource.data.customerEmail is string && resource.data.customerEmail == request.auth.token.email)
        )
      );
      // Allow guest or customer order creation
      allow create: if request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        request.resource.data.orderNumber is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Table Reservations
    match /reservations/{reservationId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          (resource.data.customerEmail is string && resource.data.customerEmail == request.auth.token.email)
        )
      );
      allow create: if request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string &&
        request.resource.data.date is string &&
        request.resource.data.time is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Catering Leads
    match /catering_leads/{leadId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.eventType is string;
      allow update, delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if request.resource.data.customerName is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.isApproved == false;
      allow update, delete: if isAdmin();
    }

    // Branches
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurant Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
