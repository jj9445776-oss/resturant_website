{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer or administrative user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "order_manager", "content_manager", "customer"] },
        "savedAddresses": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Whitelisted administrator document used for security rules lookup",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["super_admin", "manager", "order_manager", "content_manager"] },
        "assignedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "assignedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Restaurant menu food or drink item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "nameUrdu": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "shortDescription": { "type": "string", "maxLength": 280 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "image": { "type": "string", "maxLength": 512 },
        "ingredients": { "type": "array" },
        "allergens": { "type": "array" },
        "calories": { "type": "number" },
        "spicyLevel": { "type": "number" },
        "isVegetarian": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "prepTimeMinutes": { "type": "number" },
        "addOns": { "type": "array" },
        "variations": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "slug", "category", "price", "isAvailable"]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Food menu classification category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "nameUrdu": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 },
        "icon": { "type": "string", "maxLength": 64 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "slug", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food delivery or takeaway order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "deliveryType": { "type": "string", "enum": ["delivery", "pickup"] },
        "deliveryAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 32 },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["jazzcash", "easypaisa", "bank_transfer", "cod", "stripe", "card"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "preparing", "ready", "out_for_delivery", "completed", "cancelled"] },
        "transactionId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "deliveryType", "items", "subtotal", "total", "paymentMethod", "paymentStatus", "orderStatus", "createdAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual line item belonging to an order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 160 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "selectedVariation": { "type": "object" },
        "selectedAddons": { "type": "array" },
        "specialInstructions": { "type": "string", "maxLength": 280 }
      },
      "required": ["id", "orderId", "productId", "productName", "quantity", "unitPrice", "totalPrice"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Server-verified payment transaction log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "method": { "type": "string", "enum": ["jazzcash", "easypaisa", "bank_transfer", "cod", "stripe", "card"] },
        "status": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
        "transactionId": { "type": "string", "maxLength": 128 },
        "verifiedByServer": { "type": "boolean" },
        "gatewayResponse": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderId", "amount", "currency", "method", "status", "createdAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Dining table reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reservationNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "guests": { "type": "number" },
        "seatingArea": { "type": "string", "maxLength": 128 },
        "occasion": { "type": "string", "maxLength": 128 },
        "specialRequests": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerName", "customerPhone", "date", "time", "guests", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and star rating",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "dishName": { "type": "string", "maxLength": 128 },
        "isApproved": { "type": "boolean" },
        "city": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerName", "rating", "comment", "isApproved", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount promotion coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minOrder": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "expiryDate": { "type": "string", "maxLength": 32 },
        "usageLimit": { "type": "number" },
        "timesUsed": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "discountType", "value", "isActive"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "Global restaurant operational configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "restaurantName": { "type": "string", "maxLength": 128 },
        "tagline": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 10 },
        "defaultTaxRate": { "type": "number" },
        "defaultDeliveryFee": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "codEnabled": { "type": "boolean" },
        "jazzCashEnabled": { "type": "boolean" },
        "easyPaisaEnabled": { "type": "boolean" },
        "bankTransferEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "restaurantName", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer profiles and user account records"
    },
    "/admins/{adminUid}": {
      "schema": "Admin",
      "description": "Administrative authority whitelist"
    },
    "/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Food menu items catalog"
    },
    "/products/{productId}": {
      "schema": "MenuItem",
      "description": "Alias path for food menu items"
    },
    "/menuCategories/{categoryId}": {
      "schema": "MenuCategory",
      "description": "Food categories classification"
    },
    "/categories/{categoryId}": {
      "schema": "MenuCategory",
      "description": "Alias path for food categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/orderItems/{itemId}": {
      "schema": "OrderItem",
      "description": "Order line items collection"
    },
    "/orders/{orderId}/orderItems/{itemId}": {
      "schema": "OrderItem",
      "description": "Subcollection for order items"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment transactions and verification records"
    },
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Table booking reservations"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback and reviews"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount codes"
    },
    "/restaurantSettings/{settingId}": {
      "schema": "RestaurantSettings",
      "description": "Global restaurant settings configuration"
    },
    "/settings/{settingId}": {
      "schema": "RestaurantSettings",
      "description": "Alias path for restaurant settings"
    }
  }
}
